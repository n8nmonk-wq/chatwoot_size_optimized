# ==============================================================================
# CHATWOOT OPTIMIZED PRODUCTION CONFIGURATION (LOW RAM VPS)
# ==============================================================================

# 1. APPLICATION & DOMAIN SETTINGS
# Replace with your actual domain name (with https://)
FRONTEND_URL=https://chat.yourdomain.com
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=en

# 2. SECURITY KEYS (Required)
# Generate a random 64-char hex string: openssl rand -hex 64
SECRET_KEY_BASE=replace_with_a_long_random_hex_string_64_chars

# Active Record Encryption (Generate with: openssl rand -hex 16)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=replace_with_32_char_hex
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=replace_with_32_char_hex
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=replace_with_32_char_hex

# 3. LOW MEMORY / RESOURCE TUNING (Crucial for 2GB - 4GB VPS)
# Limit Puma web workers to 1 (saves ~400MB-800MB RAM)
WEB_CONCURRENCY=1
# Limit Puma threads
RAILS_MAX_THREADS=3
# Limit Sidekiq background job concurrency (default is 10-25)
SIDEKIQ_CONCURRENCY=3
# Reduce log noise to save disk and memory
LOG_LEVEL=warn
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# 4. DATABASE (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DATABASE=chatwoot_production
# Timeout safety
POSTGRES_STATEMENT_TIMEOUT=14s

# 5. CACHE & QUEUE (Redis)
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=replace_with_secure_redis_password

# 6. STORAGE (Local or Cloudflare R2 / AWS S3)
ACTIVE_STORAGE_SERVICE=local
# If using S3 / Cloudflare R2 (recommended to save VPS disk space):
# ACTIVE_STORAGE_SERVICE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# AWS_BUCKET_NAME=chatwoot-media
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# 7. EMAIL CONFIGURATION (SMTP)
MAILER_SENDER_EMAIL=Chatwoot Support <support@yourdomain.com>
SMTP_DOMAIN=yourdomain.com
SMTP_ADDRESS=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=support@yourdomain.com
SMTP_PASSWORD=replace_with_smtp_password
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_TLS=true
