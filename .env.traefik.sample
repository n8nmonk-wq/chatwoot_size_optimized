# ==============================================================================
# CHATWOOT TRAEFIK HOSTINGER VPS PRODUCTION CONFIGURATION
# ==============================================================================

# 1. APPLICATION DOMAIN (Uses your wildcard domain or your custom domain)
FRONTEND_URL=https://chatwoot.srv1275499.hstgr.cloud
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=en

# 2. SECURITY KEYS (Required)
SECRET_KEY_BASE=replace_with_64_char_random_hex
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=replace_with_32_char_hex
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=replace_with_32_char_hex
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=replace_with_32_char_hex

# 3. LOW-MEMORY / RESOURCE TUNING (Safe for your Hostinger VPS)
WEB_CONCURRENCY=1
RAILS_MAX_THREADS=3
SIDEKIQ_CONCURRENCY=3
LOG_LEVEL=warn
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# 4. DATABASE (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DATABASE=chatwoot_production
POSTGRES_STATEMENT_TIMEOUT=14s

# 5. CACHE & QUEUE (Redis)
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=replace_with_secure_redis_password

# 6. STORAGE (Local or S3/Cloudflare R2)
ACTIVE_STORAGE_SERVICE=local

# 7. EMAIL CONFIGURATION (Optional - for notifications)
MAILER_SENDER_EMAIL=Chatwoot Support <support@yourdomain.com>
SMTP_DOMAIN=yourdomain.com
SMTP_ADDRESS=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=support@yourdomain.com
SMTP_PASSWORD=replace_with_smtp_password
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_TLS=true
